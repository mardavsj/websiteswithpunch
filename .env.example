# Database (SQLite file path — Prisma resolves relative to prisma/)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Cron protection — send as Authorization: Bearer <secret> or x-cron-secret
CRON_SECRET="generate-another-secret"

# One-off / test user seed — POST /api/dev/seed-test-users with header x-seed-key
# Falls back to NEXTAUTH_SECRET if unset
SEED_SECRET="generate-a-seed-secret"

# Optional warn thresholds (days)
SSL_WARN_DAYS="30"
DOMAIN_WARN_DAYS="30"

# Stripe (optional for local demo — UI still shows Upgrade CTA)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Pro ($12/mo) — STRIPE_PRICE_ID kept as legacy alias
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID="price_..."
# Business ($39/mo)
STRIPE_PRICE_ID_BUSINESS="price_..."
# Site packs (dashboard add-ons; recurring monthly)
# Pro pack: +5 sites @ $6/mo
STRIPE_PRICE_ID_PACK_PRO="price_..."
# Business pack: +10 sites @ $8/mo
STRIPE_PRICE_ID_PACK_BUSINESS="price_..."
