# Database: PostgreSQL (e.g. Neon). Copy the connection string from Neon → Connect.
# The pooled string (host contains "-pooler") works for the app and for `npx prisma db push`.
# Keep ?sslmode=require. If Neon was asleep and the first command times out, run it again
# or add &connect_timeout=15.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Cron protection — send as Authorization: Bearer <secret> or x-cron-secret.
# Generate a different value with the same command:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET="generate-another-secret"

# One-off / test user seed — POST /api/dev/seed-test-users with header x-seed-key
# Falls back to NEXTAUTH_SECRET if unset
SEED_SECRET="generate-a-seed-secret"

# Optional warn thresholds (days)
SSL_WARN_DAYS="30"
DOMAIN_WARN_DAYS="30"

# Stripe (optional for local demo — UI still shows Upgrade CTA)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Pro ($12/mo) — STRIPE_PRICE_ID kept as legacy alias
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID="price_..."
# Business ($42/mo) — point STRIPE_PRICE_ID_BUSINESS at a $42/mo recurring Price
# (existing $39/mo subscribers can stay on their old Stripe price)
STRIPE_PRICE_ID_BUSINESS="price_..."
# Site packs (dashboard add-ons; recurring monthly)
# Pro pack: +5 sites @ $6/mo
STRIPE_PRICE_ID_PACK_PRO="price_..."
# Business pack: +10 sites @ $9/mo — point STRIPE_PRICE_ID_PACK_BUSINESS at a $9/mo recurring Price
# (existing $8/mo pack subscribers can stay on their old Stripe price)
STRIPE_PRICE_ID_PACK_BUSINESS="price_..."

# Annual billing (2 months free = 10 × monthly). Create these as recurring prices with
# interval "year" in Stripe. Monthly prices above stay as they are.
# If one is missing, choosing Annual shows a clear error naming the missing variable;
# monthly billing keeps working.
# Pro annual: $120/year (shown as $10/mo billed annually) — can sit on the Pro product
STRIPE_PRICE_PRO_ANNUAL="price_..."
# Business annual: $420/year (shown as $35/mo billed annually) — on the Business product
STRIPE_PRICE_BUSINESS_ANNUAL="price_..."
# Annual site packs. A Stripe subscription can only mix prices with the same interval, so
# annual subscribers get these instead of the monthly pack prices.
# Pro pack annual: +5 sites @ $60/year
STRIPE_PRICE_PACK_PRO_ANNUAL="price_..."
# Business pack annual: +10 sites @ $90/year
STRIPE_PRICE_PACK_BUSINESS_ANNUAL="price_..."

# Contact form (/contact). Messages are always saved to the ContactMessage table; when
# RESEND_API_KEY is set they are also emailed to the team via the Resend HTTP API.
# Without a key (e.g. local dev) the message is logged to the server console instead.
# Create a key at https://resend.com/api-keys after verifying your sending domain.
RESEND_API_KEY="re_..."
# Sender: must be on a domain verified in Resend. Default shown.
CONTACT_FROM_EMAIL="Websites With Punch <contact@websiteswithpunch.com>"
# Where contact messages are delivered (the visitor's email is set as Reply-To). Default shown.
CONTACT_TO_EMAIL="hello@websiteswithpunch.com"

# Password reset emails (/forgot-password) use the same RESEND_API_KEY. Links point at
# NEXTAUTH_URL/reset-password and expire after 1 hour. Without a key, dev logs the link to the
# server console. Optional sender for auth email; defaults to CONTACT_FROM_EMAIL.
# AUTH_FROM_EMAIL="Websites With Punch <hello@websiteswithpunch.com>"
