generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String    @unique
  password                String
  emailVerified           DateTime?
  image                   String?
  plan                    String    @default("free") // free | pro | business (paid-through)
  sitePackCount           Int       @default(0)
  /// Target pack count after a scheduled removal (applies at pendingPackChangeAt).
  pendingSitePackCount    Int?
  /// When pendingSitePackCount becomes the live limit (usually next renewal).
  pendingPackChangeAt     DateTime?
  /// Target plan after a scheduled downgrade/cancel (applies at pendingPlanAt).
  pendingPlan             String?
  /// When pendingPlan becomes live (usually next renewal / cancel date).
  pendingPlanAt           DateTime?
  /// Mirrors Stripe cancel_at_period_end for dashboard UI.
  cancelAtPeriodEnd       Boolean   @default(false)
  /// Unused (was 24h active-site swap cooldown). Kept to avoid schema churn.
  lastSiteSwapAt          DateTime?
  /// Show the "we kept your oldest" banner until dismissed.
  showDefaultLockNotice   Boolean   @default(false)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  stripeStatus            String?   // active | canceled | past_due | etc
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  accounts                Account[]
  sessions                Session[]
  sites                   Site[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id              String        @id @default(cuid())
  userId          String
  name            String
  url             String
  status          String        @default("pending") // up | down | pending | error
  lastCheckedAt   DateTime?
  lastStatusCode  Int?
  lastLatencyMs   Int?
  sslExpiresAt    DateTime?
  sslDaysLeft     Int?
  domainExpiresAt DateTime?
  domainDaysLeft  Int?
  /// Not monitored; metrics hidden from client until unlocked.
  locked          Boolean       @default(false)
  lockedAt        DateTime?
  /// Marked to stay active when a pending limit reduction applies.
  keepOnDowngrade Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults    CheckResult[]

  @@unique([userId, url])
  @@index([userId])
  @@index([userId, locked])
}

model CheckResult {
  id         String   @id @default(cuid())
  siteId     String
  status     String   // up | down | error
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
}
