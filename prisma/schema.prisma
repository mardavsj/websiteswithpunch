generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String    @unique
  password                String
  /// When the address was confirmed with an emailed code (see lib/email-verify.ts). Accounts
  /// created before VERIFICATION_STARTED_AT count as verified even while this is null.
  emailVerified           DateTime?
  image                   String?
  plan                    String    @default("free") // free | pro | business (paid-through)
  sitePackCount           Int       @default(0)
  /// Target pack count after a scheduled removal (applies at pendingPackChangeAt).
  pendingSitePackCount    Int?
  /// When pendingSitePackCount becomes the live limit (usually next renewal).
  pendingPackChangeAt     DateTime?
  /// Target plan after a scheduled downgrade/cancel (applies at pendingPlanAt).
  pendingPlan             String?
  /// When pendingPlan becomes live (usually next renewal / cancel date).
  pendingPlanAt           DateTime?
  /// Mirrors Stripe cancel_at_period_end for dashboard UI.
  cancelAtPeriodEnd       Boolean   @default(false)
  /// Unused (was 24h active-site swap cooldown). Kept to avoid schema churn.
  lastSiteSwapAt          DateTime?
  /// Show the "we kept your oldest" banner until dismissed.
  showDefaultLockNotice   Boolean   @default(false)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  stripeStatus            String?   // active | canceled | past_due | etc
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  accounts                Account[]
  sessions                Session[]
  sites                   Site[]
  contactMessages         ContactMessage[]
  passwordResetTokens     PasswordResetToken[]
  emailCodes              EmailVerificationCode[]

  @@index([emailVerified, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id              String        @id @default(cuid())
  userId          String
  name            String
  url             String
  status          String        @default("pending") // up | down | pending | error
  lastCheckedAt   DateTime?
  lastStatusCode  Int?
  lastLatencyMs   Int?
  sslExpiresAt    DateTime?
  sslDaysLeft     Int?
  domainExpiresAt DateTime?
  domainDaysLeft  Int?
  /// Not monitored; metrics hidden from client until unlocked.
  locked          Boolean       @default(false)
  lockedAt        DateTime?
  /// Marked to stay active when a pending limit reduction applies.
  keepOnDowngrade Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults    CheckResult[]

  @@unique([userId, url])
  @@index([userId])
  @@index([userId, locked])
  /// Cron: unlocked sites, least recently checked first.
  @@index([locked, lastCheckedAt])
}

model CheckResult {
  id         String   @id @default(cuid())
  siteId     String
  status     String   // up | down | error
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
  /// Daily retention prune (delete rows older than the longest analytics range).
  @@index([checkedAt])
}

/// Contact form submissions (backup copy; the team is also emailed via Resend).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String   // general | billing | custom-limits | other
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Password reset links. Only a SHA-256 hash of the token is stored; tokens are single-use and expire after 1 hour.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Fixed-window rate limit counters shared by every serverless instance. One row per key
/// (e.g. "login:ip:1.2.3.4"); expired rows are reset in place and pruned by the daily cron.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Stripe webhook events already handled (idempotency: Stripe retries and may deliver twice).
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 6-digit email verification codes: HMAC-hashed, 10-minute expiry, single use, max 5 tries.
/// Issuing a new code deletes the user's older ones.
model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}
